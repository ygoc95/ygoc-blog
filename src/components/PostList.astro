---
import type { Post } from '../utils/posts';
import { formatDate, readingTime, slugify } from '../utils/posts';
import { SITE } from '../consts';

interface Props {
  posts: Post[];
  start?: number;
}

const { posts, start = 1 } = Astro.props;
---

<div class="post-list">
  {
    posts.map((post, index) => {
      const tag = post.data.tags[0];
      return (
        <article class="post-row" data-post={post.id}>
          <div class="rank" aria-hidden="true">
            {start + index}.
          </div>
          <div class="post-main">
            <h2 class="post-title">
              <a class="title" href={`/posts/${post.id}/`}>
                {post.data.title}
              </a>
              {tag && (
                <span class="post-tag">
                  (<a href={`/tags/${slugify(tag)}/`}>{tag}</a>)
                </span>
              )}
            </h2>
            <p class="post-meta">
              <button
                class="upvote"
                type="button"
                data-upvote
                data-base={post.data.points}
                aria-pressed="false"
                aria-label={`Upvote ${post.data.title}`}
                title="Upvote"
              >
                ▲
              </button>
              <span>
                <span data-points>{post.data.points}</span> points
              </span>
              <span class="sep">by</span>
              <span>{SITE.author}</span>
              <span class="sep">|</span>
              <time datetime={post.data.date.toISOString()} data-relative>
                {formatDate(post.data.date)}
              </time>
              <span class="sep">|</span>
              <span>{readingTime(post.body)} min read</span>
            </p>
          </div>
        </article>
      );
    })
  }
</div>
