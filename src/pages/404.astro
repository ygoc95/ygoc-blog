---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/url';
---

<BaseLayout title="404" description="This page does not exist.">
  <div class="notfound">
    <p class="post-kicker">404</p>
    <h1>This page doesn't exist.</h1>
    <p>
      It may have moved, or it may never have been here. The links above are a
      better place to start.
    </p>
    <pre>GET <span id="missing-path">/this-page</span> → 404 Not Found</pre>
    <p><a href={withBase('/')}>← Back home</a></p>
  </div>
</BaseLayout>

<script is:inline>
  const missingPath = document.getElementById('missing-path');
  if (missingPath) missingPath.textContent = window.location.pathname;
</script>
