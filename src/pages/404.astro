---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="This page does not exist.">
  <div class="notfound">
    <h1>404 — page not found</h1>
    <p>
      This page was moved, deleted, or garbage collected. The good news: the
      front page still fits in a few kilobytes.
    </p>
    <pre>GET <span id="missing-path">/this-page</span> → 404 Not Found</pre>
    <p><a href="/">← Back to the front page</a></p>
  </div>
</BaseLayout>

<script is:inline>
  const missingPath = document.getElementById('missing-path');
  if (missingPath) missingPath.textContent = window.location.pathname;
</script>
