---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPublishedPosts } from '../utils/posts';
import { withBase } from '../utils/url';

const posts = await getPublishedPosts();
---

<BaseLayout>
  <h1 class="sr-only">Writing</h1>

  <div class="home-post-list">
    {
      posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <p class="page-sub">Nothing here yet. The first post is being written.</p>
      )
    }
  </div>

  <div class="list-footer">
    <a href={withBase('/archive')}>All posts →</a>
  </div>

  <p class="disclosure">
    Disclosure: All posts are written by me. I use AI tools for grammar checks.
  </p>
</BaseLayout>
