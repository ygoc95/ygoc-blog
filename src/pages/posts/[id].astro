---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import {
  formatDate,
  getPublishedPosts,
  readingTime,
  slugify,
  type Post,
} from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: Post;
  newer: Post | null;
  older: Post | null;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags } = post.data;
const minutes = readingTime(post.body);
---

<BaseLayout title={title} description={description} article>
  <article class="post">
    <header class="post-header">
      <p class="post-kicker">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} min read</span>
      </p>
      <h1>{title}</h1>
      <p class="post-lede">{description}</p>
      {
        tags.length > 0 && (
          <p class="post-tags">
            {tags.map((tag) => (
              <a href={`/tags/${slugify(tag)}/`}>#{tag}</a>
            ))}
          </p>
        )
      }
    </header>

    <div class="post-body">
      <Content />
    </div>

    <p class="post-footnote">
      Found a typo or have a thought?
      <a href={SITE.github} rel="me">Find me on GitHub</a>.
    </p>

    <nav class="post-nav" aria-label="More posts">
      {
        newer && (
          <a href={`/posts/${newer.id}/`}>
            <span class="label">← Newer</span>
            {newer.data.title}
          </a>
        )
      }
      {
        older && (
          <a class="next" href={`/posts/${older.id}/`}>
            <span class="label">Older →</span>
            {older.data.title}
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
